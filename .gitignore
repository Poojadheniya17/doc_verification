# Secrets
.env
kaggle.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Data (large / generated — never commit; scripts regenerate it)
data/raw/*
data/synthetic_forgeries/**/*
data/degraded/*
data/processed/*
!data/**/.gitkeep

# Model checkpoints (large binaries — track via Kaggle output / external storage, not git)
checkpoints/*
*.safetensors
*.bin
*.pt
*.ckpt

# Exception: the real trained LoRA adapter from the first completed SFT run
# (kernel v24, Phase 4 — see PROJECT_STATUS.md). Adapter-only, no optimizer
# state, 36MB total — small enough and important enough as real evidence for
# this portfolio project to version deliberately, unlike routine training
# checkpoints (which include much larger optimizer/scheduler state) that the
# patterns above exist to keep out of the repo by default.
!checkpoints/sft_v24_final/
!checkpoints/sft_v24_final/adapter_config.json
!checkpoints/sft_v24_final/adapter_model.safetensors
!checkpoints/sft_v24_final/README.md

# Local Hugging Face model cache (multi-GB; re-downloaded via snapshot_download, not committed)
.hf_cache/

# Notebooks checkpoints
.ipynb_checkpoints/

# Experiment tracking
wandb/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
