# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Hugging Face — needed to pull Qwen2.5-VL-7B-Instruct and push fine-tuned checkpoints
HF_TOKEN=

# Weights & Biases — experiment tracking for SFT/DPO/adversarial-round runs
WANDB_API_KEY=
WANDB_PROJECT=doc-verification-system

# Kaggle CLI — only needed once you're pushing training kernels for real GPU runs (Phase 4+)
# Setup: kaggle.com/settings -> Create New API Token -> downloads kaggle.json
# Place kaggle.json at ~/.kaggle/kaggle.json (or %USERPROFILE%\.kaggle\kaggle.json on Windows)
# rather than pasting the key here — the Kaggle CLI reads that file directly, not env vars.
KAGGLE_USERNAME=
KAGGLE_KEY=
